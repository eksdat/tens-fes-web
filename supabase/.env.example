# Copie para supabase/.env e preencha. O .env fica fora do git; este modelo é versionado.
# Gmail: SMTP_HOST=smtp.gmail.com, porta 587 (fixa no config.toml), senha de app (não a senha da conta).
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMETENTE_EMAIL=
SMTP_REMETENTE_NOME=Fisiotech

# CAPTCHA no local: secret de TESTE da Cloudflare (público, sempre aprova). O de produção fica só no painel do Supabase.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Login com Google (Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

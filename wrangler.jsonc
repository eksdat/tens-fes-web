{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fisiotech-api",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-26",
  "containers": [
    {
      "class_name": "FisiotechApi",
      "image": "./backend/Dockerfile",
      "image_build_context": "./backend",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "FisiotechApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FisiotechApi"] }
  ]
}

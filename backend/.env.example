# Supabase > Project Settings > Database > Connection string > Session pooler (JDBC)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Supabase > Project Settings > API > Project URL (sem barra no final)
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase > Project Settings > API Keys > Secret keys. Só para os anexos (bucket privado "materiais").
# Nunca no frontend nem no git. Sem ela, a API sobe e o envio de anexos responde 503.
SUPABASE_SECRET_KEY=
# Só para desenvolvimento: liga o Swagger (/swagger-ui.html e /v3/api-docs). Em produção, não definir.
SWAGGER_ENABLED=true
